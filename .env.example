# Copiar a .env.local para desarrollo o .env.production para el servidor.
SITE_URL=https://ads.registroevento.cl
CLIENT_SITE_URL=https://cliente.registroevento.cl
DATABASE_URL=postgresql://agencialabs:REEMPLAZAR@127.0.0.1:5432/agencialabs
# Generar independientemente con: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Generar con: openssl rand -base64 32. Preservar esta clave una vez conectadas cuentas.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Contraseña hex aleatoria de PostgreSQL; no usar caracteres especiales sin URL-encode.
POSTGRES_PASSWORD=
# Necesario para recuperar contraseñas por correo en producción.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AgenciaLabs <acceso@agencialabs.cl>
